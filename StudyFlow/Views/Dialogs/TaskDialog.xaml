<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="StudyFlow.Views.Dialogs.TaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    PrimaryButtonText="Create task"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="SaveButton_Click"
    DefaultButton="Primary"
    MinWidth="420"
    mc:Ignorable="d">
    <ScrollViewer MaxHeight="620"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,4,0,4">
            <TextBlock Text="Add the details you need to stay on track."
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <TextBox x:Name="TitleBox"
                     Header="Task title"
                     PlaceholderText="e.g. Finish biology notes"
                     MaxLength="120" />

            <TextBox x:Name="DescriptionBox"
                     Header="Description (optional)"
                     PlaceholderText="Add notes or a short checklist"
                     AcceptsReturn="True"
                     MinHeight="90"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <TextBox x:Name="ChecklistBox"
                     Header="Checklist (optional)"
                     PlaceholderText="One step per line"
                     AcceptsReturn="True"
                     MinHeight="82"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <CalendarDatePicker x:Name="DueDatePicker"
                                Header="Due date (optional)"
                                PlaceholderText="Choose a due date"
                                DateChanged="DueDatePicker_DateChanged" />
            <TimePicker x:Name="DueTimePicker"
                        Header="Due time"
                        ClockIdentifier="12HourClock"
                        Time="09:00:00"
                        IsEnabled="False" />
            <TextBlock Text="High-priority tasks with reminders enabled are alerted based on the selected reminder time."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <ComboBox x:Name="EstimatedMinutesBox"
                      Header="Estimated focus time"
                      SelectedIndex="2"
                      HorizontalAlignment="Stretch">
                <ComboBoxItem Content="15 minutes" Tag="15" />
                <ComboBoxItem Content="25 minutes" Tag="25" />
                <ComboBoxItem Content="30 minutes" Tag="30" />
                <ComboBoxItem Content="45 minutes" Tag="45" />
                <ComboBoxItem Content="60 minutes" Tag="60" />
                <ComboBoxItem Content="90 minutes" Tag="90" />
            </ComboBox>

            <CheckBox x:Name="RemindersEnabledBox"
                      Content="Enable reminders and alarm"
                      Click="RemindersEnabledBox_Click"
                      IsChecked="True" />
            <ComboBox x:Name="ReminderLeadBox"
                      Header="Reminder time"
                      SelectedIndex="3"
                      HorizontalAlignment="Stretch">
                <ComboBoxItem Content="At the due time only" Tag="0" />
                <ComboBoxItem Content="5 minutes before" Tag="5" />
                <ComboBoxItem Content="15 minutes before" Tag="15" />
                <ComboBoxItem Content="30 minutes before" Tag="30" />
                <ComboBoxItem Content="1 hour before" Tag="60" />
                <ComboBoxItem Content="1 day before" Tag="1440" />
            </ComboBox>

            <ComboBox x:Name="CategoryBox"
                      Header="Category"
                      SelectedIndex="1"
                      HorizontalAlignment="Stretch">
                <ComboBoxItem Content="University work" Tag="UniversityWork" />
                <ComboBoxItem Content="Personal development" Tag="Personal" />
                <ComboBoxItem Content="Projects" Tag="Projects" />
                <ComboBoxItem Content="Programming" Tag="Programming" />
            </ComboBox>

            <ComboBox x:Name="PriorityBox"
                      Header="Priority"
                      SelectedIndex="1"
                      HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Low" Tag="1" />
                <ComboBoxItem Content="Normal" Tag="2" />
                <ComboBoxItem Content="High" Tag="3" />
            </ComboBox>

            <TextBlock x:Name="ValidationMessage"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
