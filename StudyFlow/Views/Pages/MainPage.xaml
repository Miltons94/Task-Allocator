<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StudyFlow.Views.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StudyFlow.Views.Pages"
    xmlns:models="using:StudyFlow.Models"
    xmlns:components="using:StudyFlow.Views.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <StackLayout x:Key="TasksLayoutTemplate"
                     Orientation="Vertical"
                     Spacing="8"/>
        <DataTemplate x:Key="TaskItemTemplate"
                      x:DataType="models:TaskItem">
            <ItemContainer Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                           Padding="0" Margin="0" 
                           CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid Padding="0" BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <SwipeControl DataContext="{x:Bind}"
                                  HorizontalAlignment="Left"
                                  HorizontalContentAlignment="Left"
                                  VerticalAlignment="Stretch"
                                  VerticalContentAlignment="Center">
                        <SwipeControl.LeftItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Invoked="DeleteSwipeItem_Invoked"
                                           Text="Delete">
                                    <SwipeItem.IconSource>
                                        <FontIconSource Glyph="&#xE74D;" />
                                    </SwipeItem.IconSource>
                                </SwipeItem>
                                <SwipeItem Invoked="EditSwipeItem_Invoked"
                                           Text="Edit">
                                    <SwipeItem.IconSource>
                                        <FontIconSource Glyph="&#xE70F;" />
                                    </SwipeItem.IconSource>
                                </SwipeItem>
                            </SwipeItems>
                        </SwipeControl.LeftItems>
                        <SwipeControl.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Mark as complete"
                                           Invoked="MarkCompleted_Invoked">
                                    <SwipeItem.IconSource>
                                        <FontIconSource Glyph="&#xE8FB;"/>
                                    </SwipeItem.IconSource>
                                </SwipeItem>
                            </SwipeItems>
                        </SwipeControl.RightItems>
                        <Grid RowSpacing="8" 
                              Padding="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10">
                                <ToggleButton
                                        IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                                        Width="20"
                                        Height="20"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11"/>
                                </ToggleButton>
                                <TextBlock Text="{x:Bind Name}" Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource BaseTextBlockStyle}"
                                    TextTrimming="WordEllipsis"/>
                            </Grid>
                            <TextBlock Text="{x:Bind Description}" Grid.Column="1"
                                Grid.Row="1"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" 
                                TextTrimming="None" />
                        </Grid>
                    </SwipeControl>
                </Grid>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>
    
    <Grid Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CommandBar
            DefaultLabelPosition="Right" VerticalAlignment="Top" 
            VerticalContentAlignment="Center">
            
            <AppBarButton Icon="Add" Label="Add New"
                Click="AppBarButton_Click"/>
            
            <AppBarButton Icon="Edit" Label="Edit"
                Click="EditButton_Click"/>
            
            <AppBarButton Icon="Delete" Label="Delete"
                Click="DeleteButton_Click"/>
            
            <CommandBar.Content>
                <TextBlock Text="Tasks and Goals"
                    FontSize="16"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"/>
                
            </CommandBar.Content>
        </CommandBar>
        <Grid Grid.Row="1" Margin="4,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <AutoSuggestBox
                        Grid.Column="0"
                        PlaceholderText="Search.."
                        QueryIcon="Find" />

                <ItemsView Grid.Row="1" Grid.Column="0"
                    ItemsSource="{x:Bind Tasks}" 
                    x:Name="TasksListView"
                    ItemTemplate="{StaticResource TaskItemTemplate}"
                    Layout="{StaticResource TasksLayoutTemplate}"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
