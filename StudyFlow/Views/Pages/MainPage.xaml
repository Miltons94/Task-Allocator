<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StudyFlow.Views.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:StudyFlow.Converters"
    xmlns:local="using:StudyFlow.Views.Pages"
    xmlns:models="using:StudyFlow.Models"
    xmlns:vm="using:StudyFlow.ViewModels"
    xmlns:busModels="using:StudyFlow.Bus.Models"
    xmlns:components="using:StudyFlow.Views.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <StackLayout x:Key="TasksLayoutTemplate"
                     Orientation="Vertical"
                     Spacing="12"/>
        <StackLayout x:Key="AcademicEventsLayoutTemplate"
                     Orientation="Vertical"
                     Spacing="8"/>
        <converters:DueDateForegroundConverter x:Key="DueDateForegroundConverter"/>
        <converters:OptionalDateVisibilityConverter x:Key="OptionalDateVisibilityConverter"/>
        <converters:OptionalTextVisibilityConverter x:Key="OptionalTextVisibilityConverter"/>
        <converters:CompletedTaskTextDecorationsConverter x:Key="CompletedTaskTextDecorationsConverter"/>
        <converters:NonZeroVisibilityConverter x:Key="NonZeroVisibilityConverter"/>
        <DataTemplate x:Key="ChecklistItemTemplate"
                      x:DataType="models:TaskChecklistItem">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="4,2">
                <CheckBox IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                          Click="ChecklistItem_Click"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Complete checklist step" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind Title}"
                           VerticalAlignment="Center"
                           TextDecorations="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource CompletedTaskTextDecorationsConverter}}"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TaskItemTemplate"
                      x:DataType="vm:TaskViewModel">
            <ItemContainer Background="Transparent"
                           Padding="0"
                           Margin="0"
                           CornerRadius="{ThemeResource OverlayCornerRadius}">
                <SwipeControl DataContext="{x:Bind Task}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              VerticalContentAlignment="Stretch">
                    <SwipeControl.LeftItems>
                        <SwipeItems Mode="Reveal">
                            <SwipeItem
                                Background="{StaticResource SolidBackgroundFillColorBaseAltBrush}"
                                Invoked="DeleteSwipeItem_Invoked"
                                Text="Delete">
                                <SwipeItem.IconSource>
                                    <FontIconSource Glyph="&#xE74D;" />
                                </SwipeItem.IconSource>
                            </SwipeItem>
                            <SwipeItem
                                Background="{StaticResource SolidBackgroundFillColorBaseAltBrush}"
                                Invoked="EditSwipeItem_Invoked"
                                Text="Edit">
                                <SwipeItem.IconSource>
                                    <FontIconSource Glyph="&#xE70F;" />
                                </SwipeItem.IconSource>
                            </SwipeItem>
                        </SwipeItems>
                    </SwipeControl.LeftItems>
                    <SwipeControl.RightItems>
                        <SwipeItems Mode="Reveal">
                            <SwipeItem
                                Background="{StaticResource SolidBackgroundFillColorBaseAltBrush}"
                                Text="Mark as complete"
                                Invoked="MarkCompleted_Invoked">
                                <SwipeItem.IconSource>
                                    <FontIconSource Glyph="&#xE8FB;"/>
                                </SwipeItem.IconSource>
                            </SwipeItem>
                        </SwipeItems>
                    </SwipeControl.RightItems>
                    <Expander IsExpanded="{x:Bind Task.IsExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Padding="14">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="8">
                            <ToggleButton
                                IsChecked="{x:Bind Task.IsCompleted, Mode=TwoWay}"
                                Click="ToggleButton_Click"
                                Width="24"
                                Height="24"
                                Padding="0"
                                VerticalAlignment="Center"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                AutomationProperties.Name="Mark task complete">
                                <FontIcon Glyph="&#xE73E;" FontSize="12"/>
                            </ToggleButton>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Task.Name}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       TextDecorations="{x:Bind Task.IsCompleted, Mode=OneWay, Converter={StaticResource CompletedTaskTextDecorationsConverter}}"
                                       TextTrimming="WordEllipsis"
                                       TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind AllocationLabel}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Visibility="{x:Bind Task.DueDate, Mode=OneWay, Converter={StaticResource OptionalDateVisibilityConverter}}"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Padding="9,6"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE823;"
                                              FontSize="14"
                                              Foreground="{x:Bind Task.IsDueSoon, Mode=OneWay, Converter={StaticResource DueDateForegroundConverter}}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind Task.DueDateLabel, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               Foreground="{x:Bind Task.IsDueSoon, Mode=OneWay, Converter={StaticResource DueDateForegroundConverter}}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{x:Bind Task.Description}"
                                       Visibility="{x:Bind Task.Description, Mode=OneWay, Converter={StaticResource OptionalTextVisibilityConverter}}"
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <Grid Grid.Row="2"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8">
                                <TextBlock Text="{x:Bind CategoryLabel}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind FocusSummary}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        Content="Focus 25 min"
                                        Click="StartFocus_Click"
                                        DataContext="{x:Bind Task}"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        AutomationProperties.Name="Start a 25 minute focus session for this task" />
                            </Grid>
                        </Grid>
                    </Border>
                        </Expander.Header>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Padding="14"
                                Margin="0,4,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ChecklistSummary}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ItemsView ItemsSource="{x:Bind Task.Checklist, Mode=OneWay}"
                                           ItemTemplate="{StaticResource ChecklistItemTemplate}"
                                           MaxHeight="150"
                                           ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox PlaceholderText="Add a subtask"
                                             MaxLength="120"
                                             KeyDown="SubtaskInput_KeyDown" />
                                    <Button Grid.Column="1"
                                            Content="Add"
                                            Click="AddSubtask_Click"
                                            DataContext="{x:Bind Task}"
                                            Style="{ThemeResource SubtleButtonStyle}"
                                            AutomationProperties.Name="Add subtask" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>
                </SwipeControl>
            </ItemContainer>
        </DataTemplate>
        <DataTemplate x:Key="AcademicEventTemplate"
                      x:DataType="busModels:AcademicEvent">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Margin="0,0,0,8"
                    Padding="12">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      VerticalAlignment="Center"
                      ColumnSpacing="12">
                    <Border Width="54"
                            MinHeight="62"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="4">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="1">
                            <TextBlock Text="{x:Bind MonthLabel}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalTextAlignment="Center"/>
                            <TextBlock Text="{x:Bind DayLabel}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       HorizontalTextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                MinWidth="0"
                                Spacing="5">
                        <TextBlock Text="{x:Bind Title}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   HorizontalTextAlignment="Left"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Spacing="6">
                            <TextBlock Text="{x:Bind TypeLabel}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       TextWrapping="NoWrap"/>
                            <TextBlock Text="&#x00B7;"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind DateLabel}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Description}"
                                   Visibility="{x:Bind Description, Converter={StaticResource OptionalTextVisibilityConverter}}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   HorizontalTextAlignment="Left"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Location}"
                                   Visibility="{x:Bind Location, Converter={StaticResource OptionalTextVisibilityConverter}}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   HorizontalTextAlignment="Left"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            DataContext="{x:Bind}"
                            Style="{ThemeResource SubtleButtonStyle}"
                            AutomationProperties.Name="More event actions">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="More event actions" />
                        </ToolTipService.ToolTip>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Edit event" Tag="{x:Bind}" Click="EditAcademicEvent_Click" />
                                <MenuFlyoutItem Text="Create prep tasks" Tag="{x:Bind}" Click="CreateEventPrepTasks_Click" />
                                <MenuFlyoutItem Text="Delete event" Tag="{x:Bind}" Click="DeleteAcademicEvent_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

        <Grid Padding="10" Background="{StaticResource SolidBackgroundFillColorTertiaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CommandBar
            DefaultLabelPosition="Right" VerticalAlignment="Top" 
            VerticalContentAlignment="Center">
            <AppBarButton Icon="Add" Label="Create"
                          Click="AddTaskBtn_Click"/>
            <AppBarButton Icon="Calendar" Label="Add event"
                          Click="AddAcademicEvent_Click"/>
            <CommandBar.Content>
                <TextBlock Text="StudyFlow"
                    FontSize="16"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"/>

            </CommandBar.Content>
        </CommandBar>
        <Border x:Name="FocusSessionBar" Grid.Row="1" Margin="8,6,8,0"
                Visibility="Collapsed"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Padding="12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="FocusTaskTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="FocusTimerText" Text="25:00 remaining"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                <Button x:Name="PauseFocusButton" Grid.Column="1" Content="Pause" Click="PauseFocus_Click" />
                <Button x:Name="ResumeFocusButton" Grid.Column="2" Content="Resume" Click="ResumeFocus_Click" Visibility="Collapsed" />
                <Button Grid.Column="3" Content="Finish" Click="FinishFocus_Click" />
            </Grid>
        </Border>
        <Grid x:Name="SectionsGrid" Grid.Row="2" Margin="4,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TasksColumn" Width="1*" />
                <ColumnDefinition x:Name="CalendarColumn" Width="1.2*" />
            </Grid.ColumnDefinitions>
            <Grid.ColumnSpacing>12</Grid.ColumnSpacing>
            <Grid x:Name="TasksSection" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
                <TextBlock x:Name="TaskScopeTitle" Text="My Tasks" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <AutoSuggestBox
                            PlaceholderText="Search tasks"
                            QueryIcon="Find"
                            TextChanged="TaskSearch_TextChanged" />
                    <Button Grid.Column="1"
                            Style="{ThemeResource SubtleButtonStyle}"
                            AutomationProperties.Name="Sort and filter tasks">
                        <FontIcon Glyph="&#xE8CB;" FontSize="17" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Sort and filter tasks" />
                        </ToolTipService.ToolTip>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutSubItem Text="Sort by">
                                    <MenuFlyoutItem Text="Suggested order" Tag="Sort:Suggested" Click="TaskOptionsMenuItem_Click" />
                                    <MenuFlyoutItem Text="Due date" Tag="Sort:DueDate" Click="TaskOptionsMenuItem_Click" />
                                    <MenuFlyoutItem Text="Priority" Tag="Sort:Priority" Click="TaskOptionsMenuItem_Click" />
                                    <MenuFlyoutItem Text="Recently added" Tag="Sort:Newest" Click="TaskOptionsMenuItem_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem Text="Category">
                                    <MenuFlyoutItem Text="Any category" Tag="Category:Any" Click="TaskOptionsMenuItem_Click" />
                                    <MenuFlyoutItem Text="University work" Tag="Category:UniversityWork" Click="TaskOptionsMenuItem_Click" />
                                    <MenuFlyoutItem Text="Personal development" Tag="Category:Personal" Click="TaskOptionsMenuItem_Click" />
                                    <MenuFlyoutItem Text="Projects" Tag="Category:Projects" Click="TaskOptionsMenuItem_Click" />
                                    <MenuFlyoutItem Text="Programming" Tag="Category:Programming" Click="TaskOptionsMenuItem_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem Text="Priority">
                                    <MenuFlyoutItem Text="Any priority" Tag="Priority:Any" Click="TaskOptionsMenuItem_Click" />
                                    <MenuFlyoutItem Text="High priority" Tag="Priority:3" Click="TaskOptionsMenuItem_Click" />
                                    <MenuFlyoutItem Text="Normal priority" Tag="Priority:2" Click="TaskOptionsMenuItem_Click" />
                                    <MenuFlyoutItem Text="Low priority" Tag="Priority:1" Click="TaskOptionsMenuItem_Click" />
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <Border x:Name="SuggestedNextCard"
                        Grid.Row="2"
                        Padding="12"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        Visibility="Collapsed">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Suggested next"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="SuggestedNextTitle"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SuggestedNextReason"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="SuggestedNextFocusButton"
                                Grid.Column="1"
                                Content="Focus"
                                Click="StartSuggestedFocus_Click"
                                VerticalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </Grid>
                </Border>

                <!-- empty state-->
                <Grid Grid.Row="3" VerticalAlignment="Center"
                      Grid.Column="0" RowSpacing="4"
                      HorizontalAlignment="Center"
                      Visibility="{x:Bind ActiveTasks.Count, Mode=OneWay,Converter={StaticResource CollectionToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock
                            Text="No active tasks"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            VerticalAlignment="Center"/>
                    <Button
                            Click="AddTaskBtn_Click"
                            CornerRadius="8"
                            VerticalAlignment="Center" Grid.Row="1"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Add"/>
                            <TextBlock Text="Create task" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsView Grid.Row="3" Grid.Column="0"
                    ItemsSource="{x:Bind ActiveTasks,Mode=OneWay}"
                    Visibility="{x:Bind ActiveTasks.Count, Mode=OneWay, Converter={StaticResource CollectionToVisibility},ConverterParameter=Invert}"
                    x:Name="TasksListView"
                    ItemTemplate="{StaticResource TaskItemTemplate}"
                    Layout="{StaticResource TasksLayoutTemplate}"/>
                <Expander Grid.Row="4"
                          IsExpanded="False"
                          Visibility="{x:Bind CompletedTasks.Count, Mode=OneWay, Converter={StaticResource CollectionToVisibility}, ConverterParameter=Invert}">
                    <Expander.Header>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Completed tasks"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind CompletedTasks.Count, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <ItemsView ItemsSource="{x:Bind CompletedTasks, Mode=OneWay}"
                               ItemTemplate="{StaticResource TaskItemTemplate}"
                               Layout="{StaticResource TasksLayoutTemplate}"
                               MaxHeight="220"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Expander>
            </Grid>
            <Grid x:Name="CalendarSection" Grid.Column="1"
                  RowDefinitions="Auto,*"
                  RowSpacing="10"
                  Margin="0">
                <Grid ColumnDefinitions="*,Auto"
                      VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Academic calendar"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Exams, breaks, games and more"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Click="AddAcademicEvent_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.Name="Create calendar event">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                            <TextBlock Text="Add event"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="1.35*,*" ColumnSpacing="10">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto"
                              VerticalAlignment="Center"
                              Margin="2,0,2,0">
                            <TextBlock Text="UPCOMING"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind UpcomingEvents.Count, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Grid Grid.Row="1"
                              Visibility="{x:Bind UpcomingEvents.Count, Mode=OneWay, Converter={StaticResource CollectionToVisibility}}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE787;"
                                          FontSize="28"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Your calendar is clear"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           HorizontalTextAlignment="Center"/>
                                <TextBlock Text="Add an exam, holiday, game or event."
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalTextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind UpcomingEvents, Mode=OneWay}"
                                  Visibility="{x:Bind UpcomingEvents.Count, Mode=OneWay, Converter={StaticResource CollectionToVisibility}, ConverterParameter=Invert}"
                                  ItemTemplate="{StaticResource AcademicEventTemplate}"
                                  SelectionMode="None"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <Expander Grid.Row="2"
                                  IsExpanded="False"
                                  Visibility="{x:Bind PastEvents.Count, Mode=OneWay, Converter={StaticResource CollectionToVisibility}, ConverterParameter=Invert}">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Past events"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind PastEvents.Count, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            <ListView ItemsSource="{x:Bind PastEvents, Mode=OneWay}"
                                      ItemTemplate="{StaticResource AcademicEventTemplate}"
                                      SelectionMode="None"
                                      MaxHeight="200"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Expander>
                    </Grid>
                    <Border Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Padding="8"
                            VerticalAlignment="Top">
                        <CalendarView x:Name="AcademicCalendar"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      MinDate="{x:Bind CalendarMinDate}"
                                      MaxDate="{x:Bind CalendarMaxDate}"
                                      IsTodayHighlighted="True"
                                      SelectionMode="None"
                                      CalendarViewDayItemChanging="AcademicCalendar_DayItemChanging"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid> 
    </Grid>
</Page>
