<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StudyFlow.Views.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StudyFlow.Views.Pages"
    xmlns:models="using:StudyFlow.Models"
    xmlns:components="using:StudyFlow.Views.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="TaskItemTemplate" x:DataType="models:TaskItem">
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnDefinitions="*,*"
                      VerticalAlignment="Top">
                    <TextBlock
                        Text="{x:Bind Name}"
                        Style="{ThemeResource BaseTextBlockStyle}"
                        />
                    
                    <CheckBox
                        IsChecked="{x:Bind IsCompleted, Mode=TwoWay}" 
                        Content="Complete"
                        VerticalAlignment="Center"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Right"
                        CornerRadius="20"
                        />
                    
                </Grid>
                <TextBlock 
                    Text="{x:Bind Description}" 
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Grid.Row="1" TextWrapping="Wrap" 
                    TextTrimming="None" 
                    />
                
            </Grid>
        </DataTemplate>
    </Page.Resources>
    
    <Grid Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CommandBar
            DefaultLabelPosition="Right" VerticalAlignment="Top" 
            VerticalContentAlignment="Center">
            <AppBarButton 
                Icon="Add" 
                Label="Add New"
                Click="AppBarButton_Click"
                />
            
            <AppBarButton
                Icon="Edit" 
                Label="Edit"
                />
            
            <AppBarButton
                Icon="Delete" 
                Label="Delete"
                />
            
            <CommandBar.Content>
                <TextBlock
                    Text="Tasks and Goals" FontSize="16"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    />
                
            </CommandBar.Content>
        </CommandBar>
        <Grid Grid.Row="1" Margin="4,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer 
                Grid.Column="0"
                VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <AutoSuggestBox
                        PlaceholderText="Search.."
                        QueryIcon="Find" />

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind Tasks}" 
                        x:Name="TasksListView"
                        ItemTemplate="{StaticResource TaskItemTemplate}"
                        />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
